# ==========================================
# MFGX AI - Production Environment Variables
# ==========================================

# --- Backend Configuration (e.g. Render) ---
# Port number for the backend server (Render sets this dynamically, defaults to 5000)
PORT=5000

# Google Gemini API Key for Copilot & Summary Features
GEMINI_API_KEY=your-gemini-api-key-here

# (Optional) Model name to use for Gemini API (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Firebase Admin SDK credentials (used instead of MongoDB)
# IMPORTANT: In local environment, format FIREBASE_PRIVATE_KEY with escaped newlines (\n).
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# (Optional) Comma-separated list of origins allowed by CORS (e.g. https://your-app.vercel.app)
# If left blank or omitted, the backend will allow all origins (*) temporarily.
ALLOWED_ORIGINS=https://your-frontend-app.vercel.app

# --- Frontend Configuration (e.g. Vercel) ---
# URL pointing to the deployed backend server.
# IMPORTANT: In Vite, variables must be prefixed with VITE_ to be exposed to client-side code.
# Fallback is relative paths (which works with the local proxy) if not set.
VITE_API_URL=https://your-backend-app.onrender.com
